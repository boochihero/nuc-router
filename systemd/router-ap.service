[Unit]
Description=Router WiFi AP (hostapd)
After=router-firewall.service
Requires=router-firewall.service

[Service]
# hostapd runs in foreground; use Type=simple (forking would timeout
# and kill the AP in a restart loop)
Type=simple
ExecStartPre=/usr/sbin/rfkill unblock wifi
ExecStart=/usr/sbin/hostapd /etc/hostapd/hostapd.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
