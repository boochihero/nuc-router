[Unit]
Description=Router Xray Transparent Proxy
After=router-firewall.service network-online.target
Wants=network-online.target
Requires=router-firewall.service

[Service]
Type=simple
ExecStart=/usr/local/bin/xray run -config /etc/xray/client.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
