#!/usr/sbin/nft -f

flush ruleset

table inet router {
    chain forward {
        type filter hook forward priority filter; policy accept;
        iifname "eno1" oifname "wlp0s20f3" ct state related,established accept
        iifname "wlp0s20f3" oifname "eno1" accept
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "eno1" masquerade
    }

    # TCP transparent proxy via REDIRECT (no IP_TRANSPARENT needed; xray uses
    # sockopt.tproxy = "redirect" and recovers the original destination).
    # UDP (except DNS/DHCP) is left to direct routing.
    chain prerouting_redirect {
        type nat hook prerouting priority dstnat; policy accept;
        ip daddr { 127.0.0.0/8, 192.168.50.0/24 } return
        iifname != "wlp0s20f3" return
        tcp dport { 22, 80 } return
        udp dport { 53, 67, 68, 5353 } return
        meta l4proto tcp redirect to :12345
    }
}
